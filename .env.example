# Environment variables the services read today.
#
# docker-compose.yml and docker-compose.ci.yml set their own values and do not
# read this file. Use it when you run a service directly, for example:
#   cd services/phenotype-nlp && set -a && . ../../.env && set +a && uvicorn main:app --port 8001

# phenotype-nlp: spaCy package name or model directory to load first.
# If it is not installed the service falls back to en_core_web_sm, then to a
# blank English tokenizer. GET /health reports which one loaded.
MODEL_PATH=en_core_sci_md

# governance-auditor: read, but not used yet. The VLM call is mocked, so no
# request is sent anywhere whether or not a key is set.
VLM_API_KEY=
